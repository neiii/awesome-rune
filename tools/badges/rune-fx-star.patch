 // ---------- shapes ----------
+// A five-point star (point up) fitted and centred in `half`, its points rounded by `k` pt (after
+// Inigo Quilez's sdStar5; the inner radius sits at `rf` of the outer).
+fn sd_star(q: vec2f, half: vec2f, k: f32) -> f32 {
+    let rf = 0.47;
+    // Leave half a pt for antialiasing round the tips, which reach the box's edges.
+    let ro = min((half.y - 0.5) / 0.9045, (half.x - 0.5) / 0.9511);
+    let r = max(ro - k * 1.6, 1.0);
+    let k1 = vec2f(0.809016994375, -0.587785252292);
+    let k2 = vec2f(-k1.x, k1.y);
+    // y up; the bottom points sit 0.809 ro below centre and the top one ro above, so move the
+    // star down by half the difference to centre its box.
+    var p = vec2f(abs(q.x), -q.y + 0.0955 * ro);
+    p -= 2.0 * max(dot(k1, p), 0.0) * k1;
+    p -= 2.0 * max(dot(k2, p), 0.0) * k2;
+    p.x = abs(p.x);
+    p.y -= r;
+    let ba = rf * vec2f(-k1.y, k1.x) - vec2f(0.0, 1.0);
+    let h = clamp(dot(p, ba) / dot(ba, ba), 0.0, r);
+    return length(p - ba * h) * sign(p.y * ba.x - p.x * ba.y) - k;
+}
